# Copy to .env and fill in. Never commit .env (it is git-ignored).
# The paper account's login (the free trial's username and password).
TWS_USERID=
TWS_PASSWORD=
TRADING_MODE=paper
# A long random string; you enter the same once on the page (Your broker, Key).
BRIDGE_KEY=
# A fine-grained GitHub token: repository svr-net/eod only, Contents read-only.
EOD_READ_TOKEN=
# The amount a trade, in the account's currency.
CAPITAL=5000
TZ=Europe/London
# Optional: a password to watch the gateway's screen with a VNC viewer at 127.0.0.1:5900.
VNC_SERVER_PASSWORD=
# On a server (docker-compose.vps.yml): the bridge's domain, e.g. trading-bridge.example.com or
# yourname.duckdns.org; its DNS record must point to the server.
BRIDGE_DOMAIN=
