# One container for the NAS: IB Gateway logged in by IBC (the community image ghcr.io/gnzsnz/ib-gateway) and the
# broker bridge beside it, in Java (tools/ibkr/java: IBKR's official Java API, IBC's command server, HTTPS, the
# automatic day). No Python. It replaced the four containers the setup had before (ib-gateway, bridge, restarter, caddy).
# Built by GitHub (bridge-image.yml), never on the NAS; started by docker/ibkr/ibkr-nas.sh. No keys or
# settings in the image: they come from the NAS's .env at run time.

# --- IBKR's Java API (GPL-3, from IBKR's own installer) and the Java bridge, built on the build machine --------
FROM --platform=$BUILDPLATFORM eclipse-temurin:21-jdk AS java
# Compiled for Java 21: IBKR's current client needs it; IB Gateway's own Java (25 now) runs it.
ARG TWSAPI_URL=https://download2.interactivebrokers.com/installers/tws-api/stable/tws-api-stable-linux-x64.sh
RUN apt-get update && apt-get install --no-install-recommends --yes curl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/twsapi.sh "$TWSAPI_URL" \
 && sh /tmp/twsapi.sh -q -dir /opt/twsapi \
 && rm /tmp/twsapi.sh
COPY tools/ibkr/java /src/bridge
COPY tools/ibkr/java-test /src/check
# IBKR's Java client: its sources (compiled here) or its jar, wherever the installer put them.
RUN set -e; mkdir -p /build/classes; \
    d=$(find /opt/twsapi -type d -path '*/com/ib/client' 2>/dev/null | head -1); \
    jar=$(find /opt/twsapi -iname 'TwsApi*.jar' 2>/dev/null | head -1); \
    if [ -n "$d" ] && ls "$d"/*.java >/dev/null 2>&1; then \
      root=${d%/com/ib/client}; echo "IBKR Java client sources: $root (com.ib.client and com.ib.controller)"; \
      find "$root/com/ib" -name '*.java' > /tmp/api.txt; \
      libs=$(find "$root" -name '*.jar' 2>/dev/null | tr '\n' ':'); echo "with: $libs"; \
      for l in $(echo "$libs" | tr ':' ' '); do (cd /build/classes && jar xf "$l"); done; \
      javac --release 21 -nowarn -encoding UTF-8 -cp "/build/classes:$libs" -d /build/classes @/tmp/api.txt; \
    elif [ -n "$jar" ]; then \
      echo "IBKR Java client jar: $jar"; (cd /build/classes && jar xf "$jar"); \
    else \
      echo "IBKR's Java client not found; the installed folders:"; find /opt/twsapi -maxdepth 5 | head -80; exit 1; \
    fi; \
    find /opt/twsapi -maxdepth 4 -iname 'license*' -type f | head -1 | xargs -r -I{} cp {} /build/classes/TWSAPI-LICENSE.txt; \
    javac --release 21 -encoding UTF-8 -cp /build/classes -d /build/classes $(find /src/bridge -name '*.java'); \
    jar --create --file /build/bridge.jar --main-class net.svrnet.bridge.Bridge -C /build/classes .
# The bridge's checks on a stand-in IBKR (the hold book, the leftovers, the close, the report, the charts): the image is made only when they pass.
RUN set -e; mkdir -p /build/check; \
    javac --release 21 -encoding UTF-8 -cp /build/classes -d /build/check $(find /src/check -name '*.java'); \
    java -cp /build/classes:/build/check net.svrnet.bridge.HoldsCheck; \
    java -cp /build/classes:/build/check net.svrnet.bridge.StepsCheck; \
    java -cp /build/classes:/build/check net.svrnet.bridge.ParallelCheck

# IBKR's Java client sources alone (GPL-3), exported by bridge-image.yml for developing the bridge against them.
FROM scratch AS javaclient-src
COPY --from=java /opt/twsapi/source/javaclient /javaclient

# --- The container --------------------------------------------------------------------------------------------
# IB Gateway and IBC come from this image; only what the container runs is kept (slim-rootfs.sh): the image is the
# last stage, FROM scratch: IB Gateway (its own Java runtime), IBC, the bridge, bash, busybox, Xvfb, openssl, curl,
# procps and the exact shared libraries and data they load. No OpenGL stack (Xvfb without GLX, JavaFX drawing in
# software), no VNC, socat, ssh, Python, package manager or systemd.
FROM ghcr.io/gnzsnz/ib-gateway:stable AS gateway
USER root
RUN apt-get update \
 && apt-get install --no-install-recommends --yes procps util-linux openssl curl ca-certificates busybox-static gettext-base \
 && rm -rf /var/lib/apt/lists/*
# IBC's command server on localhost only (the bridge restarts the gateway through it).
RUN set -e; t=$(find / -xdev -name 'config.ini.tmpl' -path '*ibc*' 2>/dev/null | head -1); test -n "$t"; \
    sed -i -e 's/^CommandServerPort=.*/CommandServerPort=7462/' -e 's/^BindAddress=.*/BindAddress=127.0.0.1/' \
           -e 's/^ControlFrom=.*/ControlFrom=127.0.0.1/' "$t"; grep -q '^CommandServerPort=7462' "$t"
# JavaFX's software pipeline: no OpenGL (Mesa, LLVM) in the image.
RUN set -e; for f in /home/ibgateway/Jts/ibgateway/*/ibgateway.vmoptions; do \
      grep -q '^-Dprism.order=sw$' "$f" || sed -i 's/^### keep on update$/-Dprism.order=sw\n-Dprism.verbose=false\n### keep on update/' "$f"; \
      grep -q '^-Dprism.order=sw$' "$f"; done
# No web views: the embedded Chromium (jxbrowser's native part, 130 MB) and JavaFX's WebKit (111 MB) draw only web
# pages, which the API-only gateway does not show (it starts, logs in and serves the API without them).
# GATEWAY_WEB=1 keeps them.
ARG GATEWAY_WEB=0
RUN set -e; [ "$GATEWAY_WEB" = 1 ] || rm -f /home/ibgateway/Jts/ibgateway/*/jars/jxbrowser-linux64-*.jar /home/ibgateway/Jts/ibgateway/*/jre/lib/libjfxwebkit.so
COPY docker/ibkr/slim-rootfs.sh /tmp/slim-rootfs.sh
# Two filesystems, two layers that change only with the base image: the system (/rootfs: libraries, binaries, data)
# and IB Gateway with IBC (/rootfs-gw). The bridge and its scripts are the image's last, small layers, so an update
# of the bridge downloads only them.
RUN set -e; bash /tmp/slim-rootfs.sh /rootfs; \
    mkdir -p /rootfs-gw/home /rootfs-gw/app; mv /rootfs/home/ibgateway /rootfs-gw/home/; \
    j=$(cd /rootfs-gw && find home/ibgateway -path '*/jre/bin/java' -type f | head -1); test -n "$j"; ln -s "/$j" /rootfs-gw/app/java; \
    chroot /rootfs /bin/bash -c 'set -e; xkbcomp -version; envsubst --version | head -1; setpriv --version; openssl version; curl --version | head -1; pgrep --version; busybox true; command -v Xvfb'

FROM scratch
COPY --from=gateway /rootfs /
COPY --from=gateway /rootfs-gw /
COPY --from=java --chmod=644 /build/bridge.jar /app/bridge.jar
COPY --chmod=755 docker/ibkr/ibkr-start.sh /app/ibkr-start.sh
COPY --chmod=755 docker/ibkr/gateway-run.sh /app/scripts/run.sh
ARG VERSION=unknown
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    HOME=/home/ibgateway \
    TWS_PATH=/home/ibgateway/Jts \
    TWS_INI=jts.ini \
    TWS_INI_TMPL=jts.ini.tmpl \
    IBC_PATH=/home/ibgateway/ibc \
    IBC_INI=/home/ibgateway/ibc/config.ini \
    IBC_INI_TMPL=/home/ibgateway/ibc/config.ini.tmpl \
    SCRIPT_PATH=/app/scripts \
    GATEWAY_OR_TWS=gateway \
    BRIDGE_VERSION=$VERSION \
    GATEWAY_RESTART=local \
    IBC_COMMAND_PORT=7462 \
    IB_HOST=127.0.0.1 \
    HISTORY_DIR=/data/history \
    ALLOWED_ORIGIN=https://svr-net.github.io \
    READ_ONLY_API=no \
    BYPASS_WARNING=yes \
    TWOFA_TIMEOUT_ACTION=restart \
    AUTO_RESTART_TIME="11:59 PM"
WORKDIR /home/ibgateway
EXPOSE 8765
HEALTHCHECK --interval=60s --timeout=20s --start-period=180s --retries=3 \
  CMD curl -skf --max-time 15 https://127.0.0.1:8765/live >/dev/null || curl -sf --max-time 15 http://127.0.0.1:8765/live >/dev/null || exit 1
CMD ["/app/ibkr-start.sh"]
